# Copy this file to ".env" for LOCAL use only. Never commit ".env" or upload it to GitHub.
# On Vercel, set these in Project Settings > Environment Variables instead (there is no .env file there).

# Required for the live AI assistant. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# Optional. Default is claude-sonnet-5-5 (listed in Anthropic's models overview). Check the docs for current IDs.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Thinking effort: low, medium (default) or high. Lower is faster and cheaper.
# ANTHROPIC_EFFORT=medium

# Local server only. Hosting services set this for you.
# PORT=3000
