# Copy this file to ".env" for LOCAL use only. Never commit ".env" or upload it to GitHub.
# On Vercel, set this in Project Settings > Environment Variables instead.

# Required for the live AI assistant. Create a key in Google AI Studio:
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Default is gemini-3.5-flash-lite. Change only to a model enabled for your API key.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Local server only. Hosting services set this for you.
# PORT=3000
